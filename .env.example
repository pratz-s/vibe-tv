# Copy to .env. It is never committed, so your keys stay on your machine. Paste keys in yourself; never into a chat.

# --- The AI that understands what you ask for. One of these two is enough. ---
# aistudio.google.com/apikey. Free. Note: on the free tier Google may use requests to improve its products.
GEMINI_API_KEY=
# console.anthropic.com. Paid per search, and not used to train models. A Claude subscription doesn't include API access.
ANTHROPIC_API_KEY=
# If both are missing or down, Cloudflare's own free model steps in automatically.

# movieofthenight.com/about/api, for what's streaming where. Required.
MOTN_KEY=

# --- Where you are. scripts/set_city.py "Your city" fills these in. ---
CITY=
LAT=
LON=
TIMEZONE=
# Two-letter country code, e.g. in, us, gb.
COUNTRY=

# --- What you watch on. ---
# The services you pay for, as the app knows them, e.g. netflix,prime,hotstar
SERVICES=
# The same services as Movie of the Night names them, e.g. netflix,prime.subscription,hotstar
CATALOGS=
# The apps for the TV's app row and the phone remote's dock, as Android package names, comma separated.
APPS=

# --- Your remote and your assistant. ---
# The remote button that starts voice from anywhere. scripts/pick_voice_key.sh finds it. 0 = only the mic button.
VOICE_KEY=0
# What you call the assistant: "Hey Jarvis, something funny".
ASSISTANT_NAME=Jarvis

# Learn from what plays on the TV and which app is open (titles, how long, music). false = only what you say and choose.
LEARN=true

# Optional: a Spotify app's client ID (developer.spotify.com) to play music from the TV.
SPOTIFY_CLIENT_ID=

# Your TV's address on your Wi-Fi.
TV_IP=

# scripts/setup_cloud.sh makes these. Don't share them.
APP_TOKEN=
ADMIN_TOKEN=
REMOTE_KEY=
WORKER_URL=
